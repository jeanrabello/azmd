{
  "name": "runbar",
  "version": "0.1.0",
  "description": "Menu bar app for macOS that monitors Azure Logic Apps runs and notifies on failures",
  "main": "./out/main/index.js",
  "author": "Jean Rabello",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@azure/arm-appservice": "^19.0.0",
    "@azure/arm-logic": "^8.2.0",
    "@azure/arm-resourcegraph": "^5.0.0",
    "@azure/identity": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "electron@44.0.0": true
  }
}
